{
    "name": "intragile/laravel-hungarian-workdays",
    "description": "Hungarian workday calendar: statutory holidays, bridge days and working Saturdays, workday arithmetic and Carbon macros. Magyar munkanap-naptár: munkaszüneti napok, áthelyezett munkanapok, ledolgozós szombatok.",
    "keywords": [
        "laravel",
        "hungary",
        "hungarian",
        "workdays",
        "business-days",
        "holidays",
        "public-holidays",
        "calendar",
        "carbon",
        "magyar",
        "munkanap",
        "munkaszüneti-nap",
        "ünnepnap",
        "munkarend",
        "ledolgozós-szombat"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-hungarian-workdays/issues",
        "source": "https://github.com/intragile/laravel-hungarian-workdays",
        "security": "https://github.com/intragile/laravel-hungarian-workdays/security/policy"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "illuminate/support": "^12.0|^13.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "illuminate/support": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "IntrAgile\\HungarianWorkdays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntrAgile\\HungarianWorkdays\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
